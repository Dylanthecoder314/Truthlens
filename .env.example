# Set ONE provider key. Prefer the Keychain vault instead of this file:
#   npm run vault set GROQ_API_KEY   then   npm run dev
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# Optional: force a provider (anthropic | groq). Default: Anthropic if its key is set, else Groq.
# LLM_PROVIDER=groq
# ANTHROPIC_MODEL=claude-opus-5-5
# GROQ_MODEL=openai/gpt-oss-120b

# Optional: database. Defaults to a local SQLite file.
# For Vercel, use a Turso/libSQL database: libsql://<db>-<org>.turso.io
# DATABASE_URL=file:./data/truthlens.db
# DATABASE_AUTH_TOKEN=

# Optional: checks allowed per IP per hour (default 10)
# RATE_LIMIT_PER_HOUR=10
